('1', 'VibeStreams', '2026-10-22 22:05:50');

-- ----------------------------
-- Table `admin_alerts`
-- ----------------------------
DROP TABLE IF EXISTS `admin_alerts`;
CREATE TABLE `admin_alerts` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `alert_key` varchar(190) NOT NULL,
  `kind` varchar(40) NOT NULL,
  `title` varchar(190) NOT NULL,
  `message` varchar(500) NOT NULL DEFAULT '',
  `href` varchar(255) NOT NULL DEFAULT 'index.php',
  `created_at` datetime NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `alert_key_unique` (`alert_key`),
  KEY `alert_created_at` (`created_at`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

INSERT INTO `admin_alerts` (`id`, `alert_key`, `kind`, `title`, `message`, `href`, `created_at`) VALUES
('1', 'content-report-0', 'report', 'New content report', 'Short reported for other by VibeStreams.', 'reported.php?status=open', '2026-10-22 17:43:57'),
('2', 'admin-login-failed-a4401e329dd0aa14bed468e9a6f52e5f7035965563decab58198f32e1d5c3401', 'admin_login_failed', 'Failed admin sign-in', 'A sign-in attempt for VibeStream failed from IP ::1.', 'admin-activity.php', '2026-10-27 23:00:08');

-- ----------------------------
-- Table `admin_call_reads`
-- ----------------------------
DROP TABLE IF EXISTS `admin_call_reads`;
CREATE TABLE `admin_call_reads` (
  `call_id` char(32) NOT NULL,
  `user_id` int(11) NOT NULL,
  `read_at` datetime NOT NULL,
