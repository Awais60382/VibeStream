-- ----------------------------
-- Table `admin_alert_reads`
-- ----------------------------
DROP TABLE IF EXISTS `admin_alert_reads`;
CREATE TABLE `admin_alert_reads` (
  `alert_id` bigint(20) unsigned NOT NULL,
  `admin_username` varchar(100) NOT NULL,
  `read_at` datetime NOT NULL,
  PRIMARY KEY (`alert_id`,`admin_username`),
  KEY `admin_alert_read_by` (`admin_username`,`read_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

INSERT INTO `admin_alert_reads` (`alert_id`, `admin_username`, `read_at`) VALUES
