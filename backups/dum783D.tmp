-- ----------------------------
-- Table `admin_call_reads`
-- ----------------------------
DROP TABLE IF EXISTS `admin_call_reads`;
CREATE TABLE `admin_call_reads` (
  `call_id` char(32) NOT NULL,
  `user_id` int(11) NOT NULL,
  `read_at` datetime NOT NULL,
  PRIMARY KEY (`call_id`,`user_id`),
  KEY `idx_admin_call_reads_user` (`user_id`,`read_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;


-- ----------------------------
-- Table `admin_call_signals`
-- ----------------------------
DROP TABLE IF EXISTS `admin_call_signals`;
CREATE TABLE `admin_call_signals` (
  `id` bigint(20) NOT NULL AUTO_INCREMENT,
  `call_id` char(32) NOT NULL,
  `from_user` int(11) NOT NULL,
