-- Table `comments`
-- ----------------------------
DROP TABLE IF EXISTS `comments`;
CREATE TABLE `comments` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `video_id` varchar(255) NOT NULL,
  `username` varchar(100) NOT NULL,
  `comment_text` text NOT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `hearted` tinyint(1) NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `video_id` (`video_id`),
  CONSTRAINT `comments_ibfk_1` FOREIGN KEY (`video_id`) REFERENCES `videos` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=41 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;


-- ----------------------------
-- Table `content_report_notes`
-- ----------------------------
DROP TABLE IF EXISTS `content_report_notes`;
CREATE TABLE `content_report_notes` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `content_table` varchar(20) NOT NULL,
  `content_id` varchar(64) NOT NULL,
  `admin` varchar(100) NOT NULL,
  `note` text NOT NULL,
  `created_at` datetime NOT NULL,
  PRIMARY KEY (`id`),
  KEY `content_lookup` (`content_table`,`content_id`),
  KEY `created_at_idx` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;


-- ----------------------------
-- Table `content_reports`
-- ----------------------------
DROP TABLE IF EXISTS `content_reports`;
CREATE TABLE `content_reports` (
  `id` int(10) unsigned NOT NULL AUTO_INCREMENT,
  `content_table` varchar(20) NOT NULL,
  `content_id` varchar(64) NOT NULL,
  `content_type` varchar(10) NOT NULL,
  `reason` varchar(30) NOT NULL,
  `details` varchar(500) NOT NULL DEFAULT '',
  `reporter` varchar(100) NOT NULL,
  `status` varchar(12) NOT NULL DEFAULT 'open',
  `created_at` datetime NOT NULL,
  `reviewed_by` varchar(100) DEFAULT NULL,
  `reviewed_at` datetime DEFAULT NULL,
  `assigned_to` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `one_report_per_user` (`content_table`,`content_id`,`reporter`),
  KEY `status_idx` (`status`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

