-- ----------------------------
-- Triggers
-- ----------------------------
DELIMITER $$
DROP TRIGGER IF EXISTS `vs_users_lock_insert`$$
CREATE TRIGGER vs_users_lock_insert BEFORE INSERT ON `users` FOR EACH ROW
                 BEGIN
                   IF LOWER(TRIM(NEW.`email`)) = 'muhammadawaiscom0@gmail.com' THEN
                     SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'That email belongs to the owner.';
                   END IF;
                 END$$
DROP TRIGGER IF EXISTS `vs_users_lock_update`$$
CREATE TRIGGER vs_users_lock_update BEFORE UPDATE ON `users` FOR EACH ROW
                 BEGIN
                   IF OLD.`id` = '14' AND (COALESCE(LOWER(TRIM(NEW.`role`)), '') <> 'admin' OR COALESCE(LOWER(TRIM(NEW.`email`)), '') <> 'muhammadawaiscom0@gmail.com') THEN
                     SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'The owner account cannot be changed this way.';
                   END IF;
                   IF OLD.`id` <> '14' AND LOWER(TRIM(NEW.`email`)) = 'muhammadawaiscom0@gmail.com' THEN
                     SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'That email belongs to the owner.';
                   END IF;
                   IF LOWER(TRIM(OLD.`role`)) = 'admin' AND COALESCE(LOWER(TRIM(NEW.`role`)), '') <> 'admin' AND COALESCE(@vs_owner_ok, 0) <> 1 THEN
                     SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Only the owner can remove admin access.';
                   END IF;
                 END$$
DROP TRIGGER IF EXISTS `vs_users_lock_delete`$$
CREATE TRIGGER vs_users_lock_delete BEFORE DELETE ON `users` FOR EACH ROW
                 BEGIN
                   IF OLD.`id` = '14' THEN
                     SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'The owner account cannot be deleted.';
                   END IF;
                   IF LOWER(TRIM(OLD.`role`)) = 'admin' AND COALESCE(@vs_owner_ok, 0) <> 1 THEN
                     SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Only the owner can delete admin accounts.';
                   END IF;
                 END$$
DELIMITER ;

SET FOREIGN_KEY_CHECKS=1;
-- End of backup
