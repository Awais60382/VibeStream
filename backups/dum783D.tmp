-- ----------------------------
-- Table `videos`
-- ----------------------------
DROP TABLE IF EXISTS `videos`;
CREATE TABLE `videos` (
  `id` varchar(50) NOT NULL,
  `title` varchar(255) NOT NULL,
  `views` int(11) DEFAULT 0,
  `type` varchar(20) DEFAULT 'video',
  `username` varchar(50) DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `likes` int(11) DEFAULT 0,
  `subscribers` int(11) DEFAULT 0,
  `channel_name` varchar(255) NOT NULL,
  `video_url` varchar(500) NOT NULL,
  `dislikes` int(11) NOT NULL DEFAULT 0,
  `category` varchar(40) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_videos_username_created` (`username`,`created_at`),
  KEY `idx_videos_channel_created` (`channel_name`,`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;


-- ----------------------------
-- Table `vs_comment_votes`
-- ----------------------------
DROP TABLE IF EXISTS `vs_comment_votes`;
CREATE TABLE `vs_comment_votes` (
  `comment_id` bigint(20) unsigned NOT NULL,
  `voter` varchar(191) NOT NULL,
  `vote` tinyint(4) NOT NULL,
  `created_at` datetime NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`comment_id`,`voter`),
  KEY `idx_vs_comment_votes_voter` (`voter`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

